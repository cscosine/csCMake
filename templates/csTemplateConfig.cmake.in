# Package configuration of @export_namespace@, generated by csCMake: find_package(@export_namespace@ [COMPONENTS ...]).
#
# * @export_namespace@_<component>_FOUND for every requested component; a missing required component sets
#   @export_namespace@_FOUND to FALSE (with @export_namespace@_NOT_FOUND_MESSAGE)
# * public variables: @export_namespace@_BASE_DIR (install prefix of the package), @export_namespace@_CMAKE_DIR,
#   @export_namespace@_COMPONENTS_LIST, @export_namespace@_DEFAULT_COMPONENTS_LIST,
#   @export_namespace@_<component>_DEPENDENCIES
# * every other variable is _@export_namespace_sanitized@_* or @export_namespace_sanitized@_* and is unset at the end

# debug messages of this package: -D@export_namespace_sanitized@_DEBUG=ON (a plain variable, read only: no cache entry
# in the consumer)

# Print msg as a STATUS message when @export_namespace_sanitized@_DEBUG is ON.
function(@export_namespace_sanitized@_debug_message msg)
  if(@export_namespace_sanitized@_DEBUG)
    message(STATUS "${msg}")
  endif()
endfunction()

@export_namespace_sanitized@_debug_message("[@export_namespace@Config] entry point")

set(@export_namespace@_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(@export_namespace@_BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/@config_dir_to_prefix@" ABSOLUTE)

# all the components, and the ones loaded when find_package lists none
set(@export_namespace@_COMPONENTS_LIST "@components_list@")
set(@export_namespace@_DEFAULT_COMPONENTS_LIST "@default_components_list@")

# the components each component depends on, in loading order
@injected_export_dependencies@

include(CMakeFindDependencyMacro)

# find_dependency() the packages required by the component component_name, once per component
macro(@export_namespace_sanitized@_find_dependency_for_component component_name)
  if(NOT "${component_name}" IN_LIST _@export_namespace_sanitized@_dependencies_found)
    list(APPEND _@export_namespace_sanitized@_dependencies_found "${component_name}")
    @injected_find_packages_code@
  endif()
endmacro()

# requested components, or the default ones
set(_@export_namespace_sanitized@_components ${@export_namespace@_FIND_COMPONENTS})
if(NOT _@export_namespace_sanitized@_components)
  set(_@export_namespace_sanitized@_components ${@export_namespace@_DEFAULT_COMPONENTS_LIST})
endif()
set(_@export_namespace_sanitized@_dependencies_found "")

foreach(@export_namespace_sanitized@_component IN LISTS _@export_namespace_sanitized@_components)
  if(NOT @export_namespace_sanitized@_component IN_LIST @export_namespace@_COMPONENTS_LIST)
    @export_namespace_sanitized@_debug_message(
      "[@export_namespace@Config] unknown component ${@export_namespace_sanitized@_component}"
    )
    set(@export_namespace@_${@export_namespace_sanitized@_component}_FOUND FALSE)
    if(@export_namespace@_FIND_REQUIRED_${@export_namespace_sanitized@_component})
      set(@export_namespace@_FOUND FALSE)
      list(JOIN @export_namespace@_COMPONENTS_LIST ", " _@export_namespace_sanitized@_available)
      string(
        CONCAT @export_namespace@_NOT_FOUND_MESSAGE
        "unknown component ${@export_namespace_sanitized@_component}, "
        "available: ${_@export_namespace_sanitized@_available}"
      )
      unset(_@export_namespace_sanitized@_available)
    endif()
    continue()
  endif()

  # the components it depends on, then the component itself
  foreach(
    @export_namespace_sanitized@_load
    IN
    LISTS
      @export_namespace@_${@export_namespace_sanitized@_component}_DEPENDENCIES
      @export_namespace_sanitized@_component
  )
    @export_namespace_sanitized@_find_dependency_for_component(${@export_namespace_sanitized@_load})
    @export_namespace_sanitized@_debug_message(
      "[@export_namespace@Config] including ${@export_namespace_sanitized@_load}Targets.cmake"
    )
    include("${@export_namespace@_CMAKE_DIR}/targets/${@export_namespace_sanitized@_load}Targets.cmake")
  endforeach()
  set(@export_namespace@_${@export_namespace_sanitized@_component}_FOUND TRUE)
endforeach()

unset(_@export_namespace_sanitized@_components)
unset(@export_namespace_sanitized@_component)
unset(@export_namespace_sanitized@_load)
unset(_@export_namespace_sanitized@_dependencies_found)

@export_namespace_sanitized@_debug_message("[@export_namespace@Config] exit point")
