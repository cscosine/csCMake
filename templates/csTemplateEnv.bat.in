@echo off
rem Run-time environment of the build, generated by csCMake at every configure: PATH with the folders of the DLLs of
rem the programs of the build, and the variables of cs_target_runtime_environment.
rem
rem   double-click                   a command prompt with the environment
rem   call cs-env.bat [<config>]     from a command prompt: the environment in that command prompt
rem   cs-env.bat [<config>] -ps      a PowerShell with the environment
rem   .\cs-env.ps1 [<config>]        from PowerShell: the environment in that PowerShell
rem
rem <config>: one of @configs@; not needed when the build has one configuration, or when they all give the same
rem environment. Additions of your own: cs-env.local.bat next to this file, called last with the configuration as
rem argument (csCMake never writes it).

rem double-click: Explorer runs cmd /c ""<this file>" " (read before shift, which changes %0)
set "_cs_env_dir=%~dp0"
set "_cs_env_click="
set "_cs_env_cmdline=%cmdcmdline:"=%"
call set "_cs_env_cmdline=%%_cs_env_cmdline:*/c =%%"
if /i "%_cs_env_cmdline%"=="%~f0 " set "_cs_env_click=1"
if /i "%_cs_env_cmdline%"=="%~f0" set "_cs_env_click=1"

set "_cs_env_configs=@configs@"
set "_cs_env_config="
set "_cs_env_ps="
:_cs_env_args
if "%~1"=="" goto _cs_env_args_done
if /i "%~1"=="-ps" (set "_cs_env_ps=1") else set "_cs_env_config=%~1"
shift
goto _cs_env_args
:_cs_env_args_done

if not defined _cs_env_config call :_cs_env_choose
if not defined _cs_env_config goto _cs_env_fail_choose
if not exist "%_cs_env_dir%cs-env\%_cs_env_config%.bat" goto _cs_env_fail_unknown
call "%_cs_env_dir%cs-env\%_cs_env_config%.bat"
if exist "%_cs_env_dir%cs-env.local.bat" call "%_cs_env_dir%cs-env.local.bat" %_cs_env_config%
echo csCMake run-time environment: %_cs_env_config%
if defined _cs_env_ps goto _cs_env_powershell
if defined _cs_env_click goto _cs_env_cmd
call :_cs_env_clean
exit /b 0

:_cs_env_powershell
call :_cs_env_clean
where pwsh >nul 2>&1 && (pwsh -NoLogo -NoExit & exit /b)
powershell -NoLogo -NoExit
exit /b

:_cs_env_cmd
title csCMake run-time environment: %_cs_env_config%
call :_cs_env_clean
cmd /k
exit /b

:_cs_env_fail_choose
echo cs-env.bat: the configurations give different environments, give one: cs-env.bat ^<config^> (%_cs_env_configs%) 1>&2
goto _cs_env_fail
:_cs_env_fail_unknown
echo cs-env.bat: unknown configuration %_cs_env_config%, one of: %_cs_env_configs% 1>&2
:_cs_env_fail
if defined _cs_env_click pause
call :_cs_env_clean
exit /b 1

rem the configuration when none is given: the only one, or the first when all their files are identical; else asked on
rem double-click
:_cs_env_choose
set "_cs_env_first="
set "_cs_env_same=1"
for %%c in (%_cs_env_configs%) do call :_cs_env_compare %%c
if defined _cs_env_same set "_cs_env_config=%_cs_env_first%"
if not defined _cs_env_config if defined _cs_env_click set /p "_cs_env_config=Configuration (%_cs_env_configs%): "
goto :eof

:_cs_env_compare
if not defined _cs_env_first (
  set "_cs_env_first=%~1"
  goto :eof
)
fc /b "%_cs_env_dir%cs-env\%_cs_env_first%.bat" "%_cs_env_dir%cs-env\%~1.bat" >nul 2>&1 || set "_cs_env_same="
goto :eof

:_cs_env_clean
for %%v in (dir click cmdline configs config ps first same) do set "_cs_env_%%v="
goto :eof
