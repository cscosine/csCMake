# Run-time environment of the build, generated by csCMake at every configure: PATH with the folders of the DLLs of the
# programs of the build, and the variables of cs_target_runtime_environment.
#
#   .\cs-env.ps1 [<config>]    the environment in this PowerShell
#
# <config>: one of @configs@; not needed when the build has one configuration, or when they all give the same
# environment. Additions of your own: cs-env.local.ps1 next to this file, run last with the configuration as argument
# (csCMake never writes it). A local script runs with the execution policy RemoteSigned (or Unrestricted, Bypass).

& {
    param([string]$Root, [string]$Configuration)
    $configs = @(@configs_ps@)
    $dir = Join-Path $Root 'cs-env'
    if (-not $Configuration) {
        # the only configuration, or the first when all their files are identical
        $hashes = @($configs | ForEach-Object { (Get-FileHash -LiteralPath (Join-Path $dir "$_.ps1")).Hash })
        if (@($hashes | Select-Object -Unique).Count -eq 1) {
            $Configuration = $configs[0]
        } else {
            Write-Error ("cs-env.ps1: the configurations give different environments, give one: .\cs-env.ps1 " +
                "<config> ($($configs -join ', '))")
            return
        }
    }
    $file = Join-Path $dir "$Configuration.ps1"
    if (-not (Test-Path -LiteralPath $file)) {
        Write-Error "cs-env.ps1: unknown configuration $Configuration, one of: $($configs -join ', ')"
        return
    }
    & $file
    $local = Join-Path $Root 'cs-env.local.ps1'
    if (Test-Path -LiteralPath $local) {
        & $local $Configuration
    }
    Write-Host "csCMake run-time environment: $Configuration"
} $PSScriptRoot @args
