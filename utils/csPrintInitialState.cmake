include_guard(GLOBAL)

function(cs_print_initial_state)
  MESSAGE(STATUS "--- csCMake initial state ---")
  MESSAGE(STATUS "  csCMake path: ${CMAKE_CURRENT_LIST_DIR}")
  MESSAGE(STATUS "  CS_CMAKE_MODULE_PATH_HEAD: ${CS_CMAKE_MODULE_PATH_HEAD}")
  MESSAGE(STATUS "  CMAKE_MODULE_PATH: ${CMAKE_MODULE_PATH}")
  MESSAGE(STATUS "  CS_CMAKE_MODULE_PATH_TAIL: ${CS_CMAKE_MODULE_PATH_TAIL}")
  MESSAGE(STATUS "  Packages search paths:")
  MESSAGE(STATUS "    ENV{CMAKE_PREFIX_PATH} = $ENV{CMAKE_PREFIX_PATH}")
  MESSAGE(STATUS "    CS_CMAKE_PREFIX_PATH_HEAD = ${CS_CMAKE_PREFIX_PATH_HEAD}")
  MESSAGE(STATUS "    CMAKE_PREFIX_PATH = ${CMAKE_PREFIX_PATH}")
  MESSAGE(STATUS "    CS_CMAKE_PREFIX_PATH_TAIL = ${CS_CMAKE_PREFIX_PATH_TAIL}")
  MESSAGE(STATUS "    CMAKE_INSTALL_PREFIX = ${CMAKE_INSTALL_PREFIX}")
  MESSAGE(STATUS "--- csCMake ---")
endfunction()