include_guard(GLOBAL)

# Check that every header of target_name queued for installation is self-contained: for each one generate a .cpp that
# only includes it and build it as a static library linked to target_name, with the compile profiles given after
# COMPILE_PROFILES (in addition to the default profiles of the project):
#
# cs_target_check_installed_headers(<target> [COMPILE_PROFILES <profile>...])
function(cs_target_check_installed_headers target_name)
  cmake_parse_arguments(arg "" "" "COMPILE_PROFILES" ${ARGN})
  if(arg_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "[cs_target_check_installed_headers] unparsed arguments ${arg_UNPARSED_ARGUMENTS}")
  endif()

  # folder for generated files shared by all the configurations: the generated .cpp is the same in every configuration,
  # and the Xcode generator does not support sources that vary by configuration (gen-$<CONFIG>/)
  cs_get_generated_dir(generated_folder)

  # get the relative folder from the target folder to the base of the project
  file(RELATIVE_PATH destination_folder ${CSCMAKE_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR})

  # cleanup target name if aliased
  get_target_property(aliased_target_to_analyze ${target_name} ALIASED_TARGET)
  if(aliased_target_to_analyze)
    set(target_name "${aliased_target_to_analyze}")
  endif()

  # get all the headers of this target that needs to be installed
  cs_get_target_sources_to_install(${target_name} files_to_install)

  # for each file
  foreach(file ${files_to_install})
    # Extract filename without extension
    get_filename_component(file_we "${file}" NAME_WE)

    # prepare the cpp file name
    set(output_file "${generated_folder}shc/${destination_folder}/${file_we}.cpp")
    # prepare the single file inclusion
    set(file_inclusion_string
        "// Autogenerated by cs_target_check_installed_headers\n\n#include <${destination_folder}/${file}>\n")
    # file(GENERATE) rewrites the file only when its content changes (no rebuild at every configure); the same output
    # for every configuration is allowed because the content is identical
    file(
      GENERATE
      OUTPUT "${output_file}"
      CONTENT "${file_inclusion_string}\n")

    # create a static library
    set(static_lib_name "${target_name}_${file_we}")
    cs_add_library(${static_lib_name} STATIC)

    cs_target_sources(${static_lib_name} PRIVATE ${output_file})

    cs_target_link_libraries(${static_lib_name} PRIVATE ${target_name})
    cs_target_use_compile_profiles(${static_lib_name} ${arg_COMPILE_PROFILES})

    cs_finalize_target(${static_lib_name})

  endforeach()

endfunction()
