#.rst:
# csCheckInstalledHeaders
# -----------------------
#
# Check that the installed headers of a target are self-contained.
#
# Commands
# ^^^^^^^^
include_guard(GLOBAL)

#.rst:
# .. command:: cs_target_check_installed_headers
#
#   Check that each installed header of a target compiles on its own.
#
#   .. code-block:: cmake
#
#     cs_target_check_installed_headers(<target> [COMPILE_PROFILES <profile>...])
#
#   For each header queued for installation (:command:`cs_target_sources` ... ``*_INSTALL``) a .cpp including only it is
#   generated, named after the path of the header (headers with the same name in different folders are checked each);
#   the .cpp files are built as one static library ``<target>_installed_headers`` linking <target>, with the default
#   compile profiles of the project and the COMPILE_PROFILES given. A target without headers to install gets none.
#
#   ``<target>``
#     A target of the project (an alias of one is accepted).
#
#   ``COMPILE_PROFILES``
#     Compile profiles of the generated libraries, in addition to the default ones of the project (e.g.
#     ``cscmake_strict_warnings``).
#
#   :Reads: :prop_tgt:`CSCMAKE_SOURCES_TO_INSTALL`, :variable:`CSCMAKE_SOURCE_DIR`
function(cs_target_check_installed_headers target_name)
  cmake_parse_arguments(arg "" "" "COMPILE_PROFILES" ${ARGN})
  if(arg_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "[cs_target_check_installed_headers] unparsed arguments ${arg_UNPARSED_ARGUMENTS}")
  endif()

  # folder for generated files shared by all the configurations: the generated .cpp is the same in every configuration,
  # and the Xcode generator does not support sources that vary by configuration (gen-$<CONFIG>/)
  cs_get_generated_dir(generated_folder)

  # the install folder of the headers, relative to the base of the project (empty at the base)
  _cs_relative_install_folder(destination_folder)

  # cleanup target name if aliased
  get_target_property(aliased_target_to_analyze ${target_name} ALIASED_TARGET)
  if(aliased_target_to_analyze)
    set(target_name "${aliased_target_to_analyze}")
  endif()

  # get all the headers of this target that needs to be installed
  _cs_get_target_sources_to_install(${target_name} files_to_install)
  if(NOT files_to_install)
    return()
  endif()

  # one source per header, named after its installed path: a/util.h and b/util.h, or util.h and util.hpp, stay apart
  set(sources "")
  foreach(file IN LISTS files_to_install)
    cmake_path(APPEND destination_folder "${file}" OUTPUT_VARIABLE header)
    set(output_file "${generated_folder}shc/${header}.cpp")
    # file(GENERATE) rewrites the file only when its content changes (no rebuild at every configure); the same output
    # for every configuration is allowed because the content is identical
    file(
      GENERATE OUTPUT "${output_file}"
      CONTENT "// Autogenerated by cs_target_check_installed_headers\n\n#include <${header}>\n"
    )
    list(APPEND sources "${output_file}")
  endforeach()

  set(check_target "${target_name}_installed_headers")
  cs_add_library(${check_target} STATIC)
  cs_target_sources(${check_target} PRIVATE ${sources})
  cs_target_link_libraries(${check_target} PRIVATE ${target_name})
  cs_target_use_compile_profiles(${check_target} ${arg_COMPILE_PROFILES})
endfunction()
