* text=auto

# Python
*.py diff=python
*.pyi diff=python

# Markdown
*.md diff=markdown

# Line endings
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# generated presets: byte-identical on every OS (the generator writes LF)
presets/csv1/*.json text eol=lf

# Binary safety
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.pkl binary
