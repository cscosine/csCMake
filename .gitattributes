* text=auto

# Python
*.py diff=python
*.pyi diff=python

# Markdown
*.md diff=markdown

# Line endings
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# CMake sources: LF on every OS (cmake-format / cmake-lint expect unix line endings, and the generated
# <Ns>Config.cmake keeps the line endings of templates/csTemplateConfig.cmake.in)
*.cmake text eol=lf
*.cmake.in text eol=lf
CMakeLists.txt text eol=lf

# generated presets: byte-identical on every OS (the generator writes LF)
presets/csv1/*.json text eol=lf
presets/csCMakeProjectSetup.json text eol=lf
presets/layout/*.json text eol=lf

# Binary safety
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.pkl binary
