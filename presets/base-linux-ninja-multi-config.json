{
  "version":  10,
  "include": [
    "base-presets-linux.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ninja-multi-config-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/linux-ninja-multi-config/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/linux-ninja-multi-config/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja-multi-config",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-ninja-multi-config",
      "inherits": [ "cs-base-linux-ninja-multi-config", "linux-ninja-multi-config-standard-dir", "cmake-path-linux-ninja-multi-config"]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-multi-config-debug",
      "inherits": [ "cs-linux-multi-config-debug"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-release",
      "inherits": [ "cs-linux-multi-config-release"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-debug-install",
      "inherits": [ "linux-ninja-multi-config-debug", "cs-linux-multi-config-install" ]
    },
    {
      "name": "linux-ninja-multi-config-release-install",
      "inherits": [ "linux-ninja-multi-config-release", "cs-linux-multi-config-install" ]
    }
  ],  
  "workflowPresets": [
    {
      "name": "linux-ninja-multi-config",
      "steps": [
        {
          "type": "configure",
          "name": "linux-ninja-multi-config"
        },
        {
          "type": "build",
          "name": "linux-ninja-multi-config-debug"
        },
        {
          "type": "build",
          "name": "linux-ninja-multi-config-release"
        },
        {
          "type": "build",
          "name": "linux-ninja-multi-config-debug-install"
        },
        {
          "type": "build",
          "name": "linux-ninja-multi-config-release-install"
        }
      ]
    }
  ]
}
