{
  "version":  10,
  "include": [
    "base-presets-linux.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ninja-multi-config-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/linux-ninja-multi-config/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/linux-ninja-multi-config/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja-multi-config",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-ninja-multi-config",
      "inherits": [ "cs-base-linux-ninja-multi-config", "linux-ninja-multi-config-standard-dir", "cmake-path-linux-ninja-multi-config"]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-multi-config-debug",
      "inherits": [ "cs-linux-debug"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-release",
      "inherits": [ "cs-linux-release"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-relWithDebInfo",
      "inherits": [ "cs-linux-relWithDebInfo"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-paranoid",
      "inherits": [ "cs-linux-paranoid"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-debug-install",
      "inherits": [ "linux-ninja-multi-config-debug", "cs-linux-install" ]
    },
    {
      "name": "linux-ninja-multi-config-release-install",
      "inherits": [ "linux-ninja-multi-config-release", "cs-linux-install" ]
    },
    {
      "name": "linux-ninja-multi-config-relWithDebInfo-install",
      "inherits": [ "linux-ninja-multi-config-relWithDebInfo", "cs-linux-install" ]
    },
    {
      "name": "linux-ninja-multi-config-paranoid-install",
      "inherits": [ "linux-ninja-multi-config-paranoid", "cs-linux-install" ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja-multi-config-debug-test",
      "inherits": [ "cs-linux-test-base-multi-config-debug"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-release-test",
      "inherits": [ "cs-linux-test-base-multi-config-release"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-relWithDebInfo-test",
      "inherits": [ "cs-linux-test-base-multi-config-relWithDebInfo"],
      "configurePreset": "linux-ninja-multi-config"
    },
    {
      "name": "linux-ninja-multi-config-paranoid-test",
      "inherits": [ "cs-linux-test-base-multi-config-paranoid"],
      "configurePreset": "linux-ninja-multi-config"
    }
  ]
}
