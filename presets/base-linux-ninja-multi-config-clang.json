{
  "version": 10,
  "include": [
    "base-presets-linux.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ninja-multi-config-clang-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/linux-ninja-multi-config-clang/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/linux-ninja-multi-config-clang/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja-multi-config-clang;${sourceParentDir}/libs/linux-ninja-multi-config-clang",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-clang-compiler",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-ninja-multi-config-clang",
      "inherits": [
        "linux-clang-compiler",
        "cs-base-linux-ninja-multi-config-clang",
        "linux-ninja-multi-config-clang-standard-dir",
        "cmake-path-linux-ninja-multi-config-clang"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-multi-config-clang-debug",
      "inherits": [
        "cs-linux-debug"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-release",
      "inherits": [
        "cs-linux-release"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-relWithDebInfo",
      "inherits": [
        "cs-linux-relWithDebInfo"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-paranoid",
      "inherits": [
        "cs-linux-paranoid"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-debug-install",
      "inherits": [
        "linux-ninja-multi-config-clang-debug",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-multi-config-clang-release-install",
      "inherits": [
        "linux-ninja-multi-config-clang-release",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-multi-config-clang-relWithDebInfo-install",
      "inherits": [
        "linux-ninja-multi-config-clang-relWithDebInfo",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-multi-config-clang-paranoid-install",
      "inherits": [
        "linux-ninja-multi-config-clang-paranoid",
        "cs-linux-install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja-multi-config-clang-debug-test",
      "inherits": [
        "cs-linux-test-base-multi-config-debug"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-release-test",
      "inherits": [
        "cs-linux-test-base-multi-config-release"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-relWithDebInfo-test",
      "inherits": [
        "cs-linux-test-base-multi-config-relWithDebInfo"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    },
    {
      "name": "linux-ninja-multi-config-clang-paranoid-test",
      "inherits": [
        "cs-linux-test-base-multi-config-paranoid"
      ],
      "configurePreset": "linux-ninja-multi-config-clang"
    }
  ]
}
