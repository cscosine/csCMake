{
  "version": 10,
  "configurePresets": [
    {
      "name": "cs-host-linux",
      "displayName": "Host Linux ",
      "description": "The Linux Host Base Preset",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "cs-host-windows",
      "displayName": "Host Window ",
      "description": "The Window Host Base Preset",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cs-host-macos",
      "displayName": "Host MacOS ",
      "description": "The MacOS Host Base Preset",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ]
}
