{
  "version":  10,
  "include": [
    "base-presets-linux.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ninja-debug-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/linux-ninja-debug/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/linux-ninja-debug/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja-debug",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-ninja-release-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/linux-ninja-release/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/linux-ninja-release/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja-release",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-ninja-debug",
      "inherits": [ "cs-base-linux-ninja", "linux-ninja-debug-standard-dir", "cmake-path-linux-ninja-debug"]
    },
    {
      "name": "linux-ninja-release",
      "inherits": [ "cs-base-linux-ninja", "linux-ninja-release-standard-dir", "cmake-path-linux-ninja-release" ]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-debug",
      "inherits": [ "cs-linux-debug"],
      "configurePreset": "linux-ninja-debug"
    },
    {
      "name": "linux-ninja-release",
      "inherits": [ "cs-linux-release"],
      "configurePreset": "linux-ninja-release"
    },
    {
      "name": "linux-ninja-debug-install",
      "inherits": [ "linux-ninja-debug", "cs-linux-install" ]
    },
    {
      "name": "linux-ninja-release-install",
      "inherits": [ "linux-ninja-release", "cs-linux-install" ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja-debug-test",
      "inherits": [ "cs-linux-test-base"],
      "configurePreset": "linux-ninja-debug"
    },
    {
      "name": "linux-ninja-release-test",
      "inherits": [ "cs-linux-test-base"],
      "configurePreset": "linux-ninja-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-ninja-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-ninja-debug"
        },
        {
          "type": "build",
          "name": "linux-ninja-debug"
        },
        {
          "type": "build",
          "name": "linux-ninja-debug-install"
        },
        {
          "type": "test",
          "name": "linux-ninja-debug-test"
        }
      ]
    },
    {
      "name": "linux-ninja-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-ninja-release"
        },
        {
          "type": "build",
          "name": "linux-ninja-release"
        },
        {
          "type": "build",
          "name": "linux-ninja-release-install"
        },
        {
          "type": "test",
          "name": "linux-ninja-release-test"
        }
      ]
    }
  ]
}
