{
  "version": 10,
  "include": [
    "base-presets-linux.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ninja-standard-dir",
      "hidden": true,
      "installDir": "${sourceParentDir}/install/linux-ninja/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/linux-ninja",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "linux-gcc-compiler",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-ninja-debug",
      "binaryDir": "${sourceParentDir}/build/linux-ninja/${sourceDirName}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "inherits": [
        "linux-gcc-compiler",
        "cs-base-linux-ninja",
        "linux-ninja-standard-dir",
        "cmake-path-linux-ninja"
      ]
    },
    {
      "name": "linux-ninja-release",
      "binaryDir": "${sourceParentDir}/build/linux-ninja/${sourceDirName}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "inherits": [
        "linux-gcc-compiler",
        "cs-base-linux-ninja",
        "linux-ninja-standard-dir",
        "cmake-path-linux-ninja"
      ]
    },
    {
      "name": "linux-ninja-relWithDebInfo",
      "binaryDir": "${sourceParentDir}/build/linux-ninja/${sourceDirName}/relWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "inherits": [
        "linux-gcc-compiler",
        "cs-base-linux-ninja",
        "linux-ninja-standard-dir",
        "cmake-path-linux-ninja"
      ]
    },
    {
      "name": "linux-ninja-paranoid",
      "binaryDir": "${sourceParentDir}/build/linux-ninja/${sourceDirName}/paranoid",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Paranoid"
      },
      "inherits": [
        "linux-gcc-compiler",
        "cs-base-linux-ninja",
        "linux-ninja-standard-dir",
        "cmake-path-linux-ninja"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-debug",
      "inherits": [
        "cs-host-linux"
      ],
      "configurePreset": "linux-ninja-debug"
    },
    {
      "name": "linux-ninja-release",
      "inherits": [
        "cs-host-linux"
      ],
      "configurePreset": "linux-ninja-release"
    },
    {
      "name": "linux-ninja-relWithDebInfo",
      "inherits": [
        "cs-host-linux"
      ],
      "configurePreset": "linux-ninja-relWithDebInfo"
    },
    {
      "name": "linux-ninja-paranoid",
      "inherits": [
        "cs-host-linux"
      ],
      "configurePreset": "linux-ninja-paranoid"
    },
    {
      "name": "linux-ninja-debug-install",
      "inherits": [
        "linux-ninja-debug",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-release-install",
      "inherits": [
        "linux-ninja-release",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-relWithDebInfo-install",
      "inherits": [
        "linux-ninja-relWithDebInfo",
        "cs-linux-install"
      ]
    },
    {
      "name": "linux-ninja-paranoid-install",
      "inherits": [
        "linux-ninja-paranoid",
        "cs-linux-install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja-debug-test",
      "inherits": [
        "cs-linux-test-base"
      ],
      "configurePreset": "linux-ninja-debug"
    },
    {
      "name": "linux-ninja-release-test",
      "inherits": [
        "cs-linux-test-base"
      ],
      "configurePreset": "linux-ninja-release"
    },
    {
      "name": "linux-ninja-relWithDebInfo-test",
      "inherits": [
        "cs-linux-test-base"
      ],
      "configurePreset": "linux-ninja-relWithDebInfo"
    },
    {
      "name": "linux-ninja-paranoid-test",
      "inherits": [
        "cs-linux-test-base"
      ],
      "configurePreset": "linux-ninja-paranoid"
    }
  ]
}
