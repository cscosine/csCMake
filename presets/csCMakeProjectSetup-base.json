{
    "version": 10,
    "configurePresets": [
        {
            "name": "cscmake-project-setup-base",
            "displayName": "csCMake Project Setup",
            "description": "A preset to set up environment variables for csCMake project presets",
            "hidden": true,
            "binaryDir": "$env{CSCMAKE_WORKSPACE_ROOT}/build/$env{CSCMAKE_CSV1_SUB_DIR}/${sourceDirName}/$env{CSCMAKE_CSV1_SINGLE_CONFIG_SUB_DIR}",
            "installDir": "$env{CSCMAKE_WORKSPACE_ROOT}/install/$env{CSCMAKE_CSV1_SUB_DIR}/${sourceDirName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{CSCMAKE_WORKSPACE_ROOT}/install/$env{CSCMAKE_CSV1_SUB_DIR};$env{CSCMAKE_WORKSPACE_ROOT}/libs/$env{CSCMAKE_CSV1_SUB_DIR}",
                "CMAKE_MODULE_PATH": "$env{CSCMAKE_ROOT}",
                "CSCMAKE_PREFIX_PATH_HEAD": "$penv{CSCMAKE_PREFIX_PATH_HEAD}",
                "CSCMAKE_PREFIX_PATH_TAIL": "$penv{CSCMAKE_PREFIX_PATH_TAIL}",
                "CSCMAKE_MODULE_PATH_HEAD": "$penv{CSCMAKE_MODULE_PATH_HEAD}",
                "CSCMAKE_MODULE_PATH_TAIL": "$penv{CSCMAKE_MODULE_PATH_TAIL}"
            },
            "environment": {
                "CSCMAKE_WORKSPACE_ROOT": "${sourceParentDir}",
                "CSCMAKE_ROOT": "$env{CSCMAKE_WORKSPACE_ROOT}/csCMake"
            }
        }
    ]
}
