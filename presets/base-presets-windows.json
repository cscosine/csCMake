{
  "version":  10,
  "configurePresets": [
    {
      "name": "cs-host-windows",
      "displayName": "Host Window ",
      "description": "The Window Host Base Preset",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cs-base-msvc2022-x64",
      "displayName": "Host Window MSVC2022 x64",
      "description": "The Window Host Base Preset with MSVC2022 x64",
      "hidden": true,
      "inherits": [ "cs-host-windows" ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "cs-base-msvc2022-x64-LLVM",
      "displayName": "Window toolset LLVM",
      "description": "The Window with toolset LLVM",
      "hidden": true,
      "inherits": [ "cs-base-msvc2022-x64" ],
      "toolset": "ClangCL"
    }
  ],
  "buildPresets": [
     {
      "name": "cs-host-windows",
      "displayName": "Host Window ",
      "description": "The Window Host Base Preset",
      "hidden": true,
      "inherits": [],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "cs-windows-debug",
      "hidden": true,
      "inherits": ["cs-host-windows"],
      "configuration": "Debug"
    },
    {
      "name": "cs-windows-release",
      "hidden": true,
      "inherits": ["cs-host-windows"],
      "configuration": "Release"
    },
    {
      "name": "cs-windows-install",
      "hidden": true,
      "inherits": ["cs-host-windows"],
      "targets": "install"
    }
  ],
  "testPresets": [
    {
      "name": "cs-windows-test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "cs-windows-test-base-multi-config-debug",
      "hidden": true,
      "inherits": ["cs-windows-test-base"],
      "configuration": "Debug"
    },
    {
      "name": "cs-windows-test-base-multi-config-release",
      "hidden": true,
      "inherits": ["cs-windows-test-base"],
      "configuration": "Release"
    }
  ]
}