{
  "version":  10,
  "include": [
    "base-presets-windows.json",
    "${sourceDir}/cmakeUserPath.json"
  ],
  "configurePresets": [
    {
      "name": "msvc2022-x64-LLVM-standard-dir",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/msvc2022-x64-LLVM/${sourceDirName}",
      "installDir": "${sourceParentDir}/install/msvc2022-x64-LLVM/${sourceDirName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceParentDir}/install/msvc2022-x64-LLVM",
        "CMAKE_MODULE_PATH": "${sourceParentDir}/csCMake"
      }
    },
    {
      "name": "msvc2022-x64-LLVM",
      "inherits": [ "cs-base-msvc2022-x64-LLVM", "msvc2022-x64-LLVM-standard-dir", "cmake-path-msvc2022-x64-LLVM" ]
    }
  ],
  "buildPresets": [
    {
      "name": "msvc2022-x64-LLVM-debug",
      "inherits": ["cs-windows-debug"],
      "configurePreset" : "msvc2022-x64-LLVM"
    },
    {
      "name": "msvc2022-x64-LLVM-release",
      "inherits": ["cs-windows-release"],
      "configurePreset" : "msvc2022-x64-LLVM"
    },
    {
      "name": "msvc2022-x64-LLVM-relWithDebInfo",
      "inherits": ["cs-windows-relWithDebInfo"],
      "configurePreset" : "msvc2022-x64-LLVM"
    },
    {
      "name": "msvc2022-x64-LLVM-debug-install",
      "inherits": ["msvc2022-x64-LLVM-debug", "cs-windows-install"]
    },
    {
      "name": "msvc2022-x64-LLVM-release-install",
      "inherits": ["msvc2022-x64-LLVM-release", "cs-windows-install"]
    },
    {
      "name": "msvc2022-x64-LLVM-relWithDebInfo-install",
      "inherits": ["msvc2022-x64-LLVM-relWithDebInfo", "cs-windows-install"]
    }
  ],
  "testPresets": [
    {
      "name": "msvc2022-x64-LLVM-debug-test",
      "inherits": [ "cs-windows-test-base-multi-config-debug"],
      "configurePreset": "msvc2022-x64-LLVM"
    },
    {
      "name": "msvc2022-x64-LLVM-release-test",
      "inherits": [ "cs-windows-test-base-multi-config-release"],
      "configurePreset": "msvc2022-x64-LLVM"
    },
    {
      "name": "msvc2022-x64-LLVM-relWithDebInfo-test",
      "inherits": [ "cs-windows-test-base-multi-config-relWithDebInfo"],
      "configurePreset": "msvc2022-x64-LLVM"
    }
  ]
}
