# gersemi (CMake formatter) configuration of csCMake; projects using csCMake: docs/user/formatting.md
line_length: 120
indent: 2
list_expansion: favour-inlining
extensions: [gersemi/gersemi_cscmake.py] # this working copy; projects: [cscmake] (the installed package)
warn_about_unknown_commands: false
